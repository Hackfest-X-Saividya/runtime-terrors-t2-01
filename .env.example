# ZeroSentinel Backend Configuration
# Copy this file to .env and populate with local values

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database Target: PostgreSQL 16
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zerosentinel

# ML Detector Configuration
ML_ARTIFACTS_PATH=ml/artifacts
ML_STANDALONE_THRESHOLD=0.70

# Security & Ingestion Limits
MAX_UPLOAD_SIZE_BYTES=26214400       # 25 MB
MAX_UNCOMPRESSED_BYTES=104857600    # 100 MB
MAX_ARCHIVE_FILES=500
GIT_CLONE_TIMEOUT_SECONDS=30
MAX_REPO_SIZE_BYTES=52428800         # 50 MB
