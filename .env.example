# ZeroSentinel Backend Configuration
# Copy this file to .env and populate with local values

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database Configuration
# Option A: Supabase Cloud PostgreSQL (Session Pooler)
# Provide your password via SUPABASE_DB_PASSWORD (special characters will be automatically URL-encoded)
# SUPABASE_DB_PASSWORD=your_supabase_db_password_here
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.wwrhgsyemoqfnujnxuui
DB_NAME=postgres
DB_SSL=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800

# Option B: Direct DATABASE_URL (Local PostgreSQL 16 or alternative)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zerosentinel

# ML Detector Configuration
ML_ARTIFACTS_PATH=ml/artifacts
ML_STANDALONE_THRESHOLD=0.70

# Security & Ingestion Limits
MAX_UPLOAD_SIZE_BYTES=26214400       # 25 MB
MAX_UNCOMPRESSED_BYTES=104857600    # 100 MB
MAX_ARCHIVE_FILES=500
GIT_CLONE_TIMEOUT_SECONDS=30
MAX_REPO_SIZE_BYTES=52428800         # 50 MB

# CORS Allowed Frontend Origins (JSON array format)
# CORS_ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]
